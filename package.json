{
  "name": "word-document-parsing",
  "version": "1.0.0",
  "description": "Word文档解析工具 - 将Word文档转换为富文本HTML格式",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pkg": "npm run build && pkg dist/server.js --targets node18-win-x64 --output word-parser.exe --assets public/**",
